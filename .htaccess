# ============================= Portal-Administrativo .htaccess =============================
# Apache: deploy v7.16 hotfix cache index.html / Last-Modified 2026-09-08
# Regras:
#   (1) index.html NUNCA pode ser cacheado (SPA Vite tem hashing de assets, mudanças de deploy exigem imediato fetch novo index)
#   (2) Arquivos /assets/* com hash Vite (index-<hash>.js/css/png/svg etc) podem ficar 1 ano imutáveis (performance)
#   (3) Fallback SPA para React Router (#hash views como /credito#configuracoes-automacao) — rewrite se arquivo não existir
# =============================================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# --- Headers mod_headers ---
<IfModule mod_headers.c>
    # index.html (sempre fresco)
    <FilesMatch "^index\.html$">
        Header set Cache-Control "public, max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>

    # service worker (se existir)
    <FilesMatch "^(sw|service-worker)\.js$">
        Header set Cache-Control "public, max-age=0, no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Assets hashados do Vite (imutáveis por segurança contra cache estragado do Apache)
    <If "%{REQUEST_URI} =~ m#^/assets/.*-([A-Za-z0-9_-]{8,})\.(js|css|png|jpg|svg|woff2?|ttf|eot)$#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# --- Fallback SPA React Router ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-l
    RewriteRule . /index.html [L]
</IfModule>

# Compressão (opcional segurança)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Desativar listagem em pastas de backup
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>
Options -Indexes
